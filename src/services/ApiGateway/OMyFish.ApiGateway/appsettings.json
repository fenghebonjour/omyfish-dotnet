{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "species-identify-route": {
        "ClusterId": "species-cluster",
        "Match": {
          "Path": "/api/v1/species/identify"
        }
      },
      "species-route": {
        "ClusterId": "species-cluster",
        "Match": {
          "Path": "/api/v1/species/{**catch-all}"
        }
      },
      "observations-geojson-route": {
        "ClusterId": "observations-cluster",
        "Match": {
          "Path": "/api/v1/observations/geojson"
        }
      },
      "observations-route": {
        "ClusterId": "observations-cluster",
        "Match": {
          "Path": "/api/v1/observations/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://identity-service:8080"
          }
        }
      },
      "species-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://species-service:8080"
          }
        }
      },
      "observations-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://observation-service:8080"
          }
        }
      }
    }
  }
}
